{
  "name": "iac-spec",
  // Fedora + podman, built from Containerfile. Only what devcontainer features
  // cannot do on an RPM distro lives in that file; everything else stays a feature.
  "build": {
    "dockerfile": "Containerfile"
  },
  // The whole src tree is mounted so sibling repos are reachable, but it now lands
  // at the container's own home instead of mirroring the host path. The old
  // source=$HOME/src,target=$HOME/src parity existed only because docker-OUTSIDE-of-
  // docker resolved bind paths on the host, so container and host paths had to
  // match. Nothing resolves paths outside this container any more.
  "workspaceMount": "source=${localEnv:HOME}/src,target=/home/vscode/src,type=bind",
  "workspaceFolder": "/home/vscode/src",
  // podman-in-container needs --privileged, exactly as docker-in-docker did; it was
  // declared by that feature before, so it is declared here now.
  // --cgroupns=host silences a conmon cgroup warning on every EE start (cgroup v2
  // controllers are not delegated into the nested namespace). Measured: occurrences
  // go from one to zero.
  "runArgs": ["--privileged", "--cgroupns=host"],
  "remoteUser": "vscode",
  "features": {
    // NO python feature here, and the reason is measured rather than assumed.
    // It was tried on this branch with version=os-provided and installTools=false
    // -- both defaults that should have made it cheap -- and the image went from
    // 866 MB to 1381 MB. The feature installs build dependencies regardless, and
    // Fedora's dependency graph then drags in libLLVM (141 MB), Mesa's libgallium
    // (53 MB), libicudata (31 MB) and /usr/include (38 MB) behind them. gcc is
    // present in that image and absent from the dnf-based one.
    //
    // So python3 + pipx stay a dnf line in the Containerfile. Not because the
    // feature fails on Fedora -- it branches on ADJUSTED_ID and works -- but
    // because naming packages explicitly is the only way to refuse their
    // dependency closure.
    //
    // Ours, because upstream's github-cli is apt-only. This half of the
    // experiment worked: it is roughly size-neutral against the dnf line it
    // replaced, and moves one more thing into devcontainer.json.
    "ghcr.io/stelonld/devcontainer-features/github-cli:1": {},
    "ghcr.io/stelonld/devcontainer-features/opentofu:1": {},
    "ghcr.io/stelonld/devcontainer-features/packer:1": {},
    "ghcr.io/stelonld/devcontainer-features/tflint:1": {},
    // ansible-navigator installs with --include-deps, which also exposes ansible,
    // ansible-playbook, ansible-galaxy and ansible-lint from the same venv. No
    // separate ansible feature: that one pulled 479 MB, 411 MB of it collections,
    // and collections belong in the Execution Environment.
    "ghcr.io/stelonld/devcontainer-features/ansible-navigator:1": {},
    "ghcr.io/stelonld/devcontainer-features/direnv:1": {},
    // The prompt. The binary only; a dotfiles repo supplies starship.toml, and
    // its own init is guarded on STARSHIP_SHELL so the two never double-init.
    "ghcr.io/stelonld/devcontainer-features/starship:1": {},
    // Both install via nanolayer (gh-release and pipx-package respectively), so
    // neither touches a package manager and both work on Fedora.
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {},
    "ghcr.io/devcontainers-extra/features/sops:1": {}
  },
  "customizations": {
    "vscode": {
      // Lint inside the EE: the image ships ansible-lint but no ansible_collections,
      // so collection-qualified modules only resolve there.
      "settings": {
        "ansible.executionEnvironment.enabled": true,
        "ansible.executionEnvironment.image": "ghcr.io/stelonld/ansible-ee/base:latest",
        "ansible.executionEnvironment.containerEngine": "podman",
        "ansible.executionEnvironment.pull.policy": "missing",
        "ansible.validation.lint.enabled": true
      },
      "extensions": [
        "redhat.ansible",
        "redhat.vscode-yaml",
        "hashicorp.terraform",
        "hashicorp.packer",
        "ms-python.python",
        "mkhl.direnv",
        "signageos.signageos-vscode-sops"
      ]
    }
  }
}
