{
  "name": "iac-spec",
  // Fedora + podman, built from Containerfile. Only what devcontainer features
  // cannot do on an RPM distro lives in that file; everything else stays a feature.
  "build": {
    "dockerfile": "Containerfile"
  },
  // Build spec for the prebuilt image, not a daily-driver devcontainer (that is
  // templates/iac). Nothing host-specific here on purpose -- CI builds this on a
  // runner where ~/src does not exist.
  //
  // --privileged is required for podman-in-container; --cgroupns=host silences a
  // conmon cgroup warning on every EE start.
  "runArgs": ["--privileged", "--cgroupns=host"],
  "remoteUser": "vscode",
  // Ordering is not cosmetic here. devcontainers-extra's pre-commit and sops
  // install through nanolayer, which bootstraps a python if it cannot find one --
  // by calling apt-get, which does not exist on Fedora. While python3 came from
  // the Containerfile it was in the base layer and always present; as a feature it
  // has to be sequenced ahead of them explicitly. Features cannot declare this
  // themselves (pre-commit has no way to know about our python), so it is pinned
  // here. This coupling is the real cost of moving base tooling into features.
  "overrideFeatureInstallOrder": [
    "ghcr.io/stelonld/devcontainer-features/python"
  ],
  "features": {
    // Ours, not devcontainers/features/python, and the reason is measured.
    // Upstream was tried here with version=os-provided and installTools=false --
    // the two settings that should have made it cheap -- and the image went from
    // 866 MB to 1381 MB. It installs a fixed dev toolchain before it ever reads
    // the version option, because it can build CPython from source; gcc is 120 MB
    // and tk-devel pulls libGL -> Mesa -> llvm-libs, adding 140.5 MB of LLVM and
    // 52.3 MB of DRI drivers to a container that renders nothing.
    //
    // Ours installs python3, pip and pipx from the package manager and cannot
    // build from source. That is the whole difference.
    "ghcr.io/stelonld/devcontainer-features/python:1": {},
    // Ours, because upstream's github-cli is apt-only.
    "ghcr.io/stelonld/devcontainer-features/github-cli:1": {},
    "ghcr.io/stelonld/devcontainer-features/opentofu:1": {},
    "ghcr.io/stelonld/devcontainer-features/packer:1": {},
    "ghcr.io/stelonld/devcontainer-features/tflint:1": {},
    // OpenBao CLI (bao). Secrets themselves resolve in the EE, which carries
    // community.hashi_vault; this is for driving bao by hand.
    "ghcr.io/stelonld/devcontainer-features/openbao:1": {},
    // ansible-navigator installs with --include-deps, which also exposes ansible,
    // ansible-playbook, ansible-galaxy and ansible-lint from the same venv. No
    // separate ansible feature: that one pulled 479 MB, 411 MB of it collections,
    // and collections belong in the Execution Environment.
    "ghcr.io/stelonld/devcontainer-features/ansible-navigator:1": {},
    "ghcr.io/stelonld/devcontainer-features/direnv:1": {},
    // The prompt. The binary only; a dotfiles repo supplies starship.toml, and
    // its own init is guarded on STARSHIP_SHELL so the two never double-init.
    "ghcr.io/stelonld/devcontainer-features/starship:1": {},
    // Both install via nanolayer (gh-release and pipx-package respectively), so
    // neither touches a package manager and both work on Fedora.
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {},
    "ghcr.io/devcontainers-extra/features/sops:1": {}
  },
  "customizations": {
    "vscode": {
      // Lint inside the EE: the image ships ansible-lint but no ansible_collections,
      // so collection-qualified modules only resolve there.
      "settings": {
        "ansible.executionEnvironment.enabled": true,
        "ansible.executionEnvironment.image": "ghcr.io/stelonld/ansible-ee/base:latest",
        "ansible.executionEnvironment.containerEngine": "podman",
        "ansible.executionEnvironment.pull.policy": "missing",
        "ansible.validation.lint.enabled": true
      },
      "extensions": [
        "redhat.ansible",
        "redhat.vscode-yaml",
        "hashicorp.terraform",
        "hashicorp.packer",
        // OpenBao/Vault config files are HCL, which the terraform extension does
        // not cover.
        "hashicorp.hcl",
        "ms-python.python",
        "mkhl.direnv",
        "signageos.signageos-vscode-sops"
      ]
    }
  }
}
