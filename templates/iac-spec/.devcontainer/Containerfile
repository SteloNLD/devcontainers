# Base layer for the IaC image: Fedora + podman.
#
# Only the things devcontainer features cannot supply on an RPM distro live here.
# The upstream features this image used to rely on -- common-utils, python,
# github-cli, docker-in-docker -- are Debian/Ubuntu-only, so dnf does that work.
# Everything else stays a feature, listed in devcontainer.json.
#
# Why podman rather than docker-ce: the EE is already UBI9, so this puts the
# devcontainer in the same RPM space, and podman is ~120 MB smaller with no daemon
# to start before the first EE run.
FROM quay.io/fedora/fedora:44

ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=1000

# What is left here is what no feature can supply: the container engine and its
# storage, plus the handful of base utilities features themselves assume exist.
#
# podman           — container engine for Execution Environments (replaces docker-ce)
# fuse-overlayfs   — storage fallback if native overlay is unavailable when nested
#
# python3/pipx and gh moved out to our own features — see devcontainer.json.
# Both are ours rather than upstream's: upstream's github-cli is apt-only, and
# upstream's python installs a compiler toolchain that costs +515 MB on Fedora.
RUN dnf -y --setopt=install_weak_deps=False install \
        podman fuse-overlayfs containers-common \
        git openssh-clients \
        sudo which tar gzip unzip jq findutils procps-ng less ca-certificates curl \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Same uid as the old Ubuntu image, so bind-mounted files keep their owner.
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# ~/.config must exist and be owned by $USERNAME before the container starts.
# A bind mount at ~/.config/gh makes the runtime create any missing parent, and
# it creates them as root -- so without this, every rebuild lands a root-owned
# ~/.config and the first thing that tries to write there fails:
#
#   ln: failed to create symbolic link '/home/vscode/.config/starship.toml': Permission denied
#
# which is exactly what a dotfiles install does first. Same for ~/.local/bin,
# where an unprivileged starship fallback install puts its binary.
RUN mkdir -p /home/$USERNAME/.config /home/$USERNAME/.local/bin \
    && chown -R $USER_UID:$USER_GID /home/$USERNAME/.config /home/$USERNAME/.local

# Rootless podman maps the user's subuid range with newuidmap/newgidmap, which
# only works while those two carry cap_setuid/cap_setgid. dnf sets the file
# capabilities, but they do not survive the CI image build: the published image
# has neither, although it is built on a native runner. Rootless podman then
# fails with
#
#   newuidmap: write to uid_map failed: Operation not permitted
#
# Restore them the way the official podman image does. Where setting file
# capabilities is itself impossible in the build environment, setuid root is the
# equivalent that Debian ships by default.
RUN rpm --setcaps shadow-utils 2>/dev/null; \
    if ! getcap /usr/bin/newuidmap | grep -q cap_setuid; then \
        chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap; \
    fi

# Native overlay for the root store. Rootless podman keeps its own store under
# ~/.local/share/containers with the same driver; fuse-overlayfs is the fallback.
RUN mkdir -p /etc/containers \
    && printf '[storage]\ndriver = "overlay"\nrunroot = "/run/containers/storage"\ngraphroot = "/var/lib/containers/storage"\n' \
       > /etc/containers/storage.conf

# pipx installs land where the Ubuntu image put them, so PATH and docs are unchanged.
ENV PIPX_HOME=/usr/local/py-utils \
    PIPX_BIN_DIR=/usr/local/py-utils/bin \
    PATH=/usr/local/py-utils/bin:$PATH
